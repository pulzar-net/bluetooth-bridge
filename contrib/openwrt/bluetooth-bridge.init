#!/bin/sh /etc/rc.common
# bluetooth-bridge on OpenWrt (procd).
#
#   cp bluetooth-bridge.init /etc/init.d/bluetooth-bridge
#   chmod +x /etc/init.d/bluetooth-bridge
#   /etc/init.d/bluetooth-bridge enable
#   /etc/init.d/bluetooth-bridge start
#
# Do not run bluez-daemon on the same controller.
# /var is in RAM on OpenWrt: set [data] dir to a directory on flash, such as
# /etc/bluetooth-bridge/data, or bonds are lost at reboot.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/bluetooth-bridge
CONFIG=/etc/bluetooth-bridge/config.toml

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param env RUST_LOG=info
	procd_set_param file "$CONFIG"
	# Restart forever, 5 s apart.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
